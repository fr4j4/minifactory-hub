# Base de datos. Sin DATABASE_URL se usa PGlite (Postgres embebido) en ./data/pgdata
# DATABASE_URL=postgres://minifactory:minifactory@localhost:5432/minifactory
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
# Carpeta de archivos (STL, G-code, fotos). Por defecto ./data/storage
# STORAGE_DIR=./data/storage
# Binario de OrcaSlicer (AppRun del AppImage extraído). Ver scripts/install-orca.sh
ORCA_BIN=.orca/squashfs-root/AppRun
ORCA_PROFILES_DIR=.orca/squashfs-root/resources/profiles
ORCA_CONCURRENCY=2
ORCA_TIMEOUT_S=180
# Conector Bambu Lab (modo LAN). Puertos UDP donde se escuchan los anuncios SSDP de las impresoras.
# BAMBU_SSDP_PORTS=2021,1990
# BAMBU_DISABLED=1            # no conectar impresoras al iniciar (p. ej. en un servidor de pruebas)
# Bambu Cloud: solo para apuntar a la nube simulada en desarrollo (por defecto se usa api.bambulab.com / us.mqtt.bambulab.com)
# BAMBU_CLOUD_API=http://127.0.0.1:18080
# BAMBU_CLOUD_WEB=http://127.0.0.1:18080
# BAMBU_CLOUD_MQTT=127.0.0.1:18884
# BAMBU_CLOUD_CA_FILE=data/bambu-cloud-ca.pem
# IA opcional (apagada por defecto; se activa en Configuración → Inteligencia artificial). Estas variables solo dan valores de respaldo.
# AI_PROVIDER=anthropic            # anthropic | openai-compat
# AI_API_KEY=
# AI_BASE_URL=http://ollama:11434/v1
# AI_MODEL_FAST=claude-haiku-5-5
# AI_MODEL_SMART=claude-sonnet-5-5
# AI_MODEL_VISION=
# AI_LOCAL_ONLY=1                  # solo proveedores en tu red (Ollama, LM Studio…)
# AI_FORCE_DISABLED=1              # interruptor de emergencia: apaga la IA aunque esté activada en los ajustes
# AI_PRICES={"mi-modelo":[1,5]}    # USD por millón de tokens (entrada,salida) para estimar costos
